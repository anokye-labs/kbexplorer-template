{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["node", "vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* The provider package's pure `./lib` ships as plain JS (no bundled types);
       point TS at our ambient declaration for it. (TS 6.0 resolves `paths`
       relative to the tsconfig — `baseUrl` is deprecated and intentionally
       omitted.) */
    "paths": {
      "@anokye-labs/kbexplorer-provider-rich-markdown/lib": [
        "./src/engine/providers/rich-markdown/rich-markdown-lib.d.ts"
      ]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src/**/__tests__/**/*.ts", "src/**/__tests__/**/*.tsx"]
}
