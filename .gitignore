# Gitea Digital Twin Universe (DTU) harness runtime state — never committed.
# Holds the live Gitea coords + admin API token and the cached `tea` binary.
.dtu/

# Design-review screenshot artifacts — generated by `npm run capture:review`.
# The capture script (scripts/capture-review.mjs) and surface manifest
# (scripts/review-surfaces.json) ARE committed; the raw captured images are not.
# review/baselines/ IS committed (these are the reference PNGs for the gate).
review/screenshots/
# Visual-regression diff images — generated by `npm run verify:visual`.
# These are transient; never committed.
review/diffs/
# Visual-regression diff report — transient run artifact.
review/visual-diff-report.json
