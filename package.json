{
  "name": "kbexplorer-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-manifest.js",
    "build": "tsc -b && vite build",
    "build:local": "npm run prebuild && tsc -b && VITE_KB_LOCAL=true vite build",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:gitea": "playwright test --config playwright.gitea.config.ts",
    "test:e2e:full-loop": "playwright test --config playwright.full-loop.config.ts",
    "dtu:up": "node twins/gitea/bootstrap.mjs",
    "dtu:seed": "node twins/gitea/seed.mjs",
    "dtu:twin": "node twins/gitea/server.mjs",
    "dtu:tea": "node twins/gitea/tea.mjs",
    "dtu:down": "node twins/gitea/teardown.mjs",
    "dtu:reset": "node twins/gitea/teardown.mjs --purge && node twins/gitea/bootstrap.mjs && node twins/gitea/seed.mjs",
    "preview": "vite preview",
    "validate": "node scripts/validate-graph.js",
    "validate:drift": "node scripts/check-manifest-drift.js",
    "assess": "node scripts/assess-graph.js",
    "derive": "node scripts/derive-content.js",
    "compare": "node scripts/compare-content.js",
    "kb:dev": "kbexplorer dev",
    "kb:build": "kbexplorer build",
    "kb:generate": "kbexplorer generate",
    "capture:review": "node scripts/capture-review.mjs",
    "update:baselines": "node scripts/capture-review.mjs --update-baselines",
    "verify:visual": "node scripts/verify-visual.mjs",
    "explore:dtu": "node scripts/explore-dtu.mjs"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.73.7",
    "@fluentui/react-icons": "^2.0.323",
    "@octokit/rest": "^22.0.1",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "vis-data": "^8.0.3",
    "vis-network": "^10.0.2",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.5",
    "vitest": "^4.1.4"
  }
}
