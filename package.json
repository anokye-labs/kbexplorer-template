{
  "name": "kbexplorer-template",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "postinstall": "node scripts/postinstall-kbx.mjs",
    "prebuild": "kbx manifest",
    "build": "tsc -b && vite build",
    "build:local": "npm run prebuild && tsc -b && node ./scripts/run-vite-build.mjs",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "golden:fixtures": "node tests/golden/fixtures/build-remote-fixture.mjs",
    "golden:update": "node tests/golden/fixtures/build-remote-fixture.mjs && UPDATE_GOLDEN=1 vitest run --config vitest.config.ts tests/golden",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:gitea": "playwright test --config playwright.gitea.config.ts",
    "test:e2e:full-loop": "playwright test --config playwright.full-loop.config.ts",
    "dtu:up": "node twins/gitea/bootstrap.mjs",
    "dtu:seed": "node twins/gitea/seed.mjs",
    "dtu:twin": "node twins/gitea/server.mjs",
    "dtu:tea": "node twins/gitea/tea.mjs",
    "dtu:down": "node twins/gitea/teardown.mjs",
    "dtu:reset": "node twins/gitea/teardown.mjs --purge && node twins/gitea/bootstrap.mjs && node twins/gitea/seed.mjs",
    "preview": "vite preview",
    "validate": "kbx graph validate",
    "validate:drift": "kbx manifest --check",
    "assess": "kbx graph assess",
    "audit:runtime": "kbx manifest && node scripts/audit-runtime-graph.mjs",
    "audit:runtime:strict": "kbx manifest && node scripts/audit-runtime-graph.mjs --fail-on=issues-not-linked-to-repo,prs-not-linked-to-repo,repo-meta-repo-root-disconnected,cluster-proliferation,unreachable-from-hub,genuine-orphans",
    "audit:visual": "node scripts/audit-visual.mjs",
    "audit:visual:strict": "node scripts/audit-visual.mjs --fail-on=hud-related-links,legend-cluster-count,map-canvas-non-blank,map-edge-visibility,map-label-coverage,focus-neighbour-labels",
    "derive": "kbx graph derive",
    "compare": "kbx graph compare",
    "kb:dev": "kbexplorer dev",
    "kb:build": "kbexplorer build",
    "kb:generate": "kbx manifest",
    "capture:review": "node scripts/capture-review.mjs",
    "update:baselines": "node scripts/capture-review.mjs --update-baselines",
    "verify:visual": "node scripts/verify-visual.mjs",
    "explore:dtu": "node scripts/explore-dtu.mjs"
  },
  "dependencies": {
    "@anokye-labs/kbexplorer-core": "^0.6.0",
    "@anokye-labs/kbexplorer-engine": "^0.1.0",
    "@anokye-labs/kbexplorer-provider-rich-markdown": "^0.1.2",
    "@anokye-labs/kbexplorer-view-kit": "*",
    "@fluentui/react-components": "^9.74.2",
    "@fluentui/react-icons": "^2.0.323",
    "@octokit/rest": "^22.0.1",
    "marked": "^18.0.0",
    "mermaid": "^11.16.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "7.18.0",
    "sanitize-html": "^2.17.5",
    "sql.js": "^1.14.1",
    "vis-data": "^8.0.4",
    "vis-network": "^10.1.0",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "@anokye-labs/kbexplorer-engine": "^0.1.0",
    "dompurify": "^3.4.13",
    "nanoid": "^3.3.18",
    "react-router": "7.18.0",
    "react-router-dom": "7.18.0"
  },
  "devDependencies": {
    "@anokye-labs/kbexplorer-example-quotes": "file:examples/quotes-provider",
    "@anokye-labs/kbx": "^0.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.5",
    "vitest": "^4.1.9"
  }
}
